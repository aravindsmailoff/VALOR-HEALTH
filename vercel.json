{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "aegistwin": {
      "root": "aegistwin",
      "framework": "fastapi"
    },
    "folio-app": {
      "root": "folio-app",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "aegistwin",
          "format": "url",
          "env": "AEGISTWIN_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "aegistwin"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "folio-app"
      }
    }
  ]
}
