# ==========================================
# VALOR Health - Web Application Environment (.env.example)
# ==========================================

# Application Metadata
NEXT_PUBLIC_APP_NAME="VALOR Health"
NEXT_PUBLIC_APP_TAGLINE="Continuous Coverage & Predictive Clinical Digital Twin"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AegisTwin Clinical Engine API (FastAPI backend)
NEXT_PUBLIC_API_URL="http://localhost:8000"

# Feature Flags
NEXT_PUBLIC_ENABLE_SIMULATOR=true
NEXT_PUBLIC_ENABLE_AUDIT_LOGS=true
