# ==========================================
# VALOR Health Platform - Global Environment Configuration
# ==========================================

# --- Frontend (folio-app) ---
NEXT_PUBLIC_APP_NAME="VALOR Health"
NEXT_PUBLIC_APP_TAGLINE="Continuous Coverage & Predictive Clinical Digital Twin"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:8000"

# --- Backend Clinical Engine (AegisTwin) ---
AEGISTWIN_HOST="0.0.0.0"
AEGISTWIN_PORT=8000
AEGISTWIN_ENV="production"
AEGISTWIN_LOG_LEVEL="INFO"

# --- Security & Compliance ---
RBAC_ENABLED=true
AUDIT_LOG_ENABLED=true
